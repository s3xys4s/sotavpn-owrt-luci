[Unit]
Description=Sota Gateway isolated tunnel and diagnostic client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/sota-lab/current/tools/panel_runtime.py /opt/sota-lab/current/image
RuntimeDirectory=sota-lab
RuntimeDirectoryMode=0755
PrivateMounts=yes
UMask=0077
KillMode=mixed
TimeoutStopSec=20
Restart=on-failure
RestartSec=5
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
